# Copy file này thành .env (cùng cấp) rồi điền giá trị thật - KHÔNG commit
# .env vào git, KHÔNG dán giá trị thật vào chat với AI. Để trống 1 nhóm biến
# thì tool tương ứng tự báo lỗi "chưa cấu hình" thay vì chạy giả.

# Google Drive - service account (Google Cloud Console > IAM > Service
# Accounts > tạo key JSON, scope Drive API bật sẵn, share thư mục đích cho
# email service account). Dùng cho generate_image/generate_video lưu file
# thật lên Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Đăng bài thật lên Facebook Page (developers.facebook.com > app > Page
# Access Token dài hạn của đúng Page muốn đăng).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Đăng video thật lên TikTok (TikTok for Developers > Content Posting API,
# access token của tài khoản đã được duyệt).
TIKTOK_ACCESS_TOKEN=

# Đăng bài thật lên WordPress (Users > Profile > Application Passwords -
# KHÔNG dùng mật khẩu đăng nhập thường).
WORDPRESS_SITE_URL=
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=
